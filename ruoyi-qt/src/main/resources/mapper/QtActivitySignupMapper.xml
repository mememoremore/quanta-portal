<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.qt.mapper.QtActivitySignupMapper">
    
    <resultMap type="QtActivitySignup" id="QtActivitySignupResult">
        <result property="signupId"    column="signup_id"    />
        <result property="activityId"    column="activity_id"    />
        <result property="userId"    column="user_id"    />
        <result property="status"    column="status"    />
        <result property="signupTime"    column="signup_time"    />
        <result property="cancelTime"    column="cancel_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="activityTitle"    column="activity_title"    />
        <result property="activityStart"    column="activity_start"    />
        <result property="activityEnd"    column="activity_end"    />
        <result property="locationDesc"    column="location_desc"    />
        <result property="userName"    column="user_name"    />
        <result property="nickName"    column="nick_name"    />
        <result property="memberNo"    column="member_no"    />
        <result property="memberDepartment"    column="member_department"    />
        <result property="memberTitle"    column="member_title"    />
        <result property="memberCohort"    column="member_cohort"    />
        <result property="studentNo"    column="student_no"    />
        <result property="major"    column="major"    />
        <result property="phonenumber"    column="phonenumber"    />
        <result property="capacity"    column="capacity"    />
        <result property="activityType"    column="activity_type"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectQtActivitySignupVo">
        select signup_id, activity_id, user_id, status, signup_time, cancel_time, create_by, create_time, update_by, update_time from qt_activity_signup
    </sql>

    <select id="selectQtActivitySignupList" parameterType="QtActivitySignup" resultMap="QtActivitySignupResult">
        <include refid="selectQtActivitySignupVo"/>
        <where>  
            <if test="activityId != null "> and activity_id = #{activityId}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="signupTime != null "> and signup_time = #{signupTime}</if>
            <if test="cancelTime != null "> and cancel_time = #{cancelTime}</if>
        </where>
    </select>

    <select id="selectQtActivitySignupDetailList" parameterType="QtActivitySignup" resultMap="QtActivitySignupResult">
        select s.signup_id, s.activity_id, s.user_id, s.status, s.signup_time, s.cancel_time,
               s.create_by, s.create_time, s.update_by, s.update_time, s.remark,
               a.title as activity_title, a.activity_start, a.activity_end, a.location_desc, a.capacity, a.activity_type,
               u.user_name, u.nick_name, u.member_no, u.member_department, u.member_title, u.member_cohort,
               u.student_no, u.major, u.phonenumber
        from qt_activity_signup s
        left join qt_activity a on s.activity_id = a.activity_id
        left join sys_user u on s.user_id = u.user_id
        <where>
            <if test="activityId != null "> and s.activity_id = #{activityId}</if>
            <if test="userId != null "> and s.user_id = #{userId}</if>
            <if test="status != null  and status != ''"> and s.status = #{status}</if>
            <if test="signupTime != null "> and s.signup_time = #{signupTime}</if>
            <if test="cancelTime != null "> and s.cancel_time = #{cancelTime}</if>
            <if test="activityTitle != null and activityTitle != ''"> and a.title like concat('%', #{activityTitle}, '%')</if>
            <if test="locationDesc != null and locationDesc != ''"> and a.location_desc like concat('%', #{locationDesc}, '%')</if>
            <if test="userName != null and userName != ''"> and u.user_name like concat('%', #{userName}, '%')</if>
            <if test="nickName != null and nickName != ''"> and u.nick_name like concat('%', #{nickName}, '%')</if>
            <if test="memberNo != null and memberNo != ''"> and u.member_no like concat('%', #{memberNo}, '%')</if>
            <if test="memberDepartment != null and memberDepartment != ''"> and u.member_department like concat('%', #{memberDepartment}, '%')</if>
            <if test="memberTitle != null and memberTitle != ''"> and u.member_title like concat('%', #{memberTitle}, '%')</if>
            <if test="memberCohort != null and memberCohort != ''"> and u.member_cohort like concat('%', #{memberCohort}, '%')</if>
        </where>
    </select>
    
    <select id="selectQtActivitySignupBySignupId" parameterType="Long" resultMap="QtActivitySignupResult">
        <include refid="selectQtActivitySignupVo"/>
        where signup_id = #{signupId}
    </select>

    <insert id="insertQtActivitySignup" parameterType="QtActivitySignup" useGeneratedKeys="true" keyProperty="signupId">
        insert into qt_activity_signup
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="activityId != null">activity_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="signupTime != null">signup_time,</if>
            <if test="cancelTime != null">cancel_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="activityId != null">#{activityId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="signupTime != null">#{signupTime},</if>
            <if test="cancelTime != null">#{cancelTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateQtActivitySignup" parameterType="QtActivitySignup">
        update qt_activity_signup
        <trim prefix="SET" suffixOverrides=",">
            <if test="activityId != null">activity_id = #{activityId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="signupTime != null">signup_time = #{signupTime},</if>
            <if test="cancelTime != null">cancel_time = #{cancelTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where signup_id = #{signupId}
    </update>

    <delete id="deleteQtActivitySignupBySignupId" parameterType="Long">
        delete from qt_activity_signup where signup_id = #{signupId}
    </delete>

    <delete id="deleteQtActivitySignupBySignupIds" parameterType="String">
        delete from qt_activity_signup where signup_id in 
        <foreach item="signupId" collection="array" open="(" separator="," close=")">
            #{signupId}
        </foreach>
    </delete>
</mapper>