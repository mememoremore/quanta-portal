    <sql id="selectQtClothingOrderVo">
        select order_id, order_no, user_id, item_id, selected_color, selected_size, quantity, unit_price, total_amount, payment_config_id, payment_proof_path, payment_time, status, confirmed_by, confirmed_at, create_by, create_time, update_by, update_time from qt_clothing_order
    </sql>

    <select id="selectQtClothingOrderList" parameterType="QtClothingOrder" resultMap="QtClothingOrderResult">
        <include refid="selectQtClothingOrderVo"/>
        <where>  
            <if test="orderNo != null  and orderNo != ''"> and order_no = #{orderNo}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="itemId != null "> and item_id = #{itemId}</if>
            <if test="selectedColor != null  and selectedColor != ''"> and selected_color = #{selectedColor}</if>
            <if test="selectedSize != null  and selectedSize != ''"> and selected_size = #{selectedSize}</if>
            <if test="quantity != null "> and quantity = #{quantity}</if>
            <if test="unitPrice != null "> and unit_price = #{unitPrice}</if>
            <if test="totalAmount != null "> and total_amount = #{totalAmount}</if>
            <if test="paymentConfigId != null "> and payment_config_id = #{paymentConfigId}</if>
            <if test="paymentProofPath != null  and paymentProofPath != ''"> and payment_proof_path = #{paymentProofPath}</if>
            <if test="paymentTime != null "> and payment_time = #{paymentTime}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectQtClothingOrderDetailList" parameterType="QtClothingOrder" resultMap="QtClothingOrderResult">
        select o.order_id, o.order_no, o.user_id, o.item_id, o.selected_color, o.selected_size, o.quantity,
               o.unit_price, o.total_amount, o.payment_config_id, o.payment_proof_path, o.payment_time, o.status,
               o.confirmed_by, o.confirmed_at,
               o.create_by, o.create_time, o.update_by, o.update_time,
               i.item_name, i.effect_image_path,
               p.payment_name, p.qr_image_path,
               u.user_name, u.nick_name, u.member_no, u.member_department, u.member_title, u.member_cohort
        from qt_clothing_order o
        left join qt_clothing_item i on o.item_id = i.item_id
        left join qt_payment_config p on o.payment_config_id = p.config_id
        left join sys_user u on o.user_id = u.user_id
        <where>
            <if test="orderNo != null  and orderNo != ''"> and o.order_no = #{orderNo}</if>
            <if test="userId != null "> and o.user_id = #{userId}</if>
            <if test="itemId != null "> and o.item_id = #{itemId}</if>
            <if test="selectedColor != null  and selectedColor != ''"> and o.selected_color = #{selectedColor}</if>
            <if test="selectedSize != null  and selectedSize != ''"> and o.selected_size = #{selectedSize}</if>
            <if test="quantity != null "> and o.quantity = #{quantity}</if>
            <if test="unitPrice != null "> and o.unit_price = #{unitPrice}</if>
            <if test="totalAmount != null "> and o.total_amount = #{totalAmount}</if>
            <if test="paymentConfigId != null "> and o.payment_config_id = #{paymentConfigId}</if>
            <if test="paymentProofPath != null  and paymentProofPath != ''"> and o.payment_proof_path = #{paymentProofPath}</if>
            <if test="paymentTime != null "> and o.payment_time = #{paymentTime}</if>
            <if test="status != null  and status != ''"> and o.status = #{status}</if>
            <if test="itemName != null and itemName != ''"> and i.item_name like concat('%', #{itemName}, '%')</if>
            <if test="paymentName != null and paymentName != ''"> and p.payment_name like concat('%', #{paymentName}, '%')</if>
            <if test="userName != null and userName != ''"> and u.user_name like concat('%', #{userName}, '%')</if>
            <if test="nickName != null and nickName != ''"> and u.nick_name like concat('%', #{nickName}, '%')</if>
            <if test="memberNo != null and memberNo != ''"> and u.member_no like concat('%', #{memberNo}, '%')</if>
            <if test="memberDepartment != null and memberDepartment != ''"> and u.member_department like concat('%', #{memberDepartment}, '%')</if>
            <if test="memberTitle != null and memberTitle != ''"> and u.member_title like concat('%', #{memberTitle}, '%')</if>
            <if test="memberCohort != null and memberCohort != ''"> and u.member_cohort like concat('%', #{memberCohort}, '%')</if>
        </where>
    </select>
    
    <select id="selectQtClothingOrderByOrderId" parameterType="Long" resultMap="QtClothingOrderResult">
        <include refid="selectQtClothingOrderVo"/>
        where order_id = #{orderId}
    </select>

